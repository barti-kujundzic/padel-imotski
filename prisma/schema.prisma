datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Rezervacija {
  id         Int      @id @default(autoincrement())
  ime        String
  telefon    String
  email      String
  datum      String
  vrijeme    String
  token      String   @unique
  potvrdjeno Boolean  @default(false)
  createdAt  DateTime @default(now())
}